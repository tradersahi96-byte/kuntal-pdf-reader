{
  "expo": {
    "name": "Kuntal Documents",
    "slug": "kuntal-documents",
    "version": "9.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./icon.png",
    "android": {
      "package": "com.kuntal.documents",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "expo-camera",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "versionName": "V9.1",
      "features": [
        "native-pdf-viewer",
        "scanner-auto-manual",
        "multi-page-scan",
        "image-enhancement",
        "ocr",
        "merge",
        "split",
        "rotate",
        "annotations",
        "signature",
        "watermark",
        "share",
        "bookmarks",
        "pdf-info"
      ]
    }
  }
}
