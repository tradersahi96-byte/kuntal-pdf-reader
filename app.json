{
  "expo": {
    "name": "Kuntal Documents",
    "slug": "kuntal-documents",
    "version": "9.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./icon.png",
    "android": {
      "package": "com.kuntal.documents",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#111827"
      }
    },
    "plugins": [
      "expo-camera",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "versionName": "V9.2.1",
      "features": [
        "native-pdf-viewer",
        "scanner-auto-manual",
        "multi-page-scan",
        "image-enhancement",
        "ocr",
        "merge",
        "split",
        "rotate",
        "annotations",
        "signature",
        "watermark",
        "share",
        "bookmarks",
        "pdf-info"
      ],
      "stability": [
        "expo-sdk-53-pinned-dependencies",
        "new-architecture-disabled-for-native-pdf-compatibility",
        "explicit-babel-config"
      ],
      "eas": {
        "projectId": "a570a555-2aa1-4d13-9b57-3069bca6c664"
      }
    },
    "newArchEnabled": false,
    "owner": "yashjat"
  }
}
