{
  "expo": {
    "name": "Kuntal Documents",
    "slug": "kuntal-documents",
    "owner": "yashjat",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "package": "com.kuntal.pdfreader",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kuntal Documents to use your camera to scan physical pages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kuntal Documents to access your gallery to convert images into PDF."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dbb3dd38-f261-4180-8635-aeb33ba3a093"
      }
    }
  }
}
